AIFOS_ENV=development
AIFOS_DATABASE_URL=sqlite:///./data/aifos.db
AIFOS_ANALYST_THRESHOLD=7.0
AIFOS_PORTFOLIO_MARKDOWN_PATH=data/my_profile.md
AIFOS_WORKSPACE_STORAGE_PATH=storage/workspaces
AIFOS_WORKER_MAX_REPAIR_ATTEMPTS=2
AIFOS_ANALYST_PROVIDER=auto
AIFOS_PROPOSAL_PROVIDER=auto
AIFOS_WORKER_PROVIDER=auto

# Worker engine: "scaffold" (one-shot LLM draft + ZIP) or "claude_code"
# (autonomous Claude Code agent: plans, codes, runs/tests in a real folder).
AIFOS_WORKER_ENGINE=scaffold
# claude_code engine: folder where the agent does real work (each job = subfolder).
# Point this at a folder you control and open to review. No ZIP is sent.
# SAFETY: with bypassPermissions (below) the agent runs shell freely on THIS
# machine. Prefer a dedicated folder/drive — ideally a container or VM — so a
# bad command can't reach the rest of your system.
AIFOS_DELIVERY_ROOT=storage/deliveries
# Path to the Claude Code CLI (reuses its existing login; no API key needed).
AIFOS_CLAUDE_BIN=claude
# Require approving the agent's PLAN.md on Telegram before it executes.
# Set false when you want it to continue automatically and only ping at final QA.
AIFOS_AGENT_PLAN_GATE=true
AIFOS_AGENT_MAX_TURNS=60
AIFOS_AGENT_MAX_REPAIRS=1
AIFOS_AGENT_RUN_TIMEOUT_SECONDS=1800
# Claude Code permission mode. "bypassPermissions" = agent runs shell freely
# (the only mode that works headless on Windows; safety = folder confinement +
# plan-gate). WARNING: in this mode the allow/deny guardrail is NOT enforced at
# runtime — the agent can run any shell command on this machine. Mitigate by
# running on a dedicated/sandboxed AIFOS_DELIVERY_ROOT (container/VM) and keeping
# the plan-gate on. On Linux/macOS/containers use "default" to enforce the
# command allow/deny lists in app/services/agent/guardrail.py.
AIFOS_AGENT_PERMISSION_MODE=bypassPermissions
# Opt-in hardening: install a PreToolUse hook that denies destructive Bash
# commands (rm -rf, sudo, git push, ssh, ...) even under bypassPermissions.
# Default false = unchanged behavior. Set true for an extra runtime guardrail.
AIFOS_AGENT_ENFORCE_GUARDRAIL_HOOK=false

# Scout Agent
AIFOS_SCOUT_API_BASE_URL=http://127.0.0.1:8001
AIFOS_SCOUT_INTERVAL_SECONDS=900
AIFOS_SCOUT_LIMIT_PER_SOURCE=25
AIFOS_RSS_FEED_URLS=https://weworkremotely.com/categories/remote-programming-jobs.rss,https://remoteok.com/remote-jobs.rss
AIFOS_REDDIT_SUBREDDITS=forhire,freelance_forhire
AIFOS_REDDIT_USER_AGENT=windows:ai-freelancer-os:v0.1 (by /u/dancru299)

# Inbox Hunter via Gmail IMAP
AIFOS_GMAIL_IMAP_HOST=imap.gmail.com
AIFOS_GMAIL_IMAP_PORT=993
AIFOS_GMAIL_EMAIL=
AIFOS_GMAIL_APP_PASSWORD=
AIFOS_GMAIL_MAILBOX=INBOX
AIFOS_GMAIL_ALERT_SUBJECTS=Upwork Job Alert,LinkedIn Job Alert
AIFOS_GMAIL_SEARCH_WINDOW_DAYS=2
AIFOS_GMAIL_MARK_SEEN=false

# Telegram
AIFOS_TELEGRAM_BOT_TOKEN=
AIFOS_TELEGRAM_DEFAULT_CHAT_ID=
AIFOS_TELEGRAM_WEBHOOK_SECRET=
AIFOS_TELEGRAM_API_BASE=https://api.telegram.org
# "webhook" needs a public HTTPS URL; "polling" pulls updates (no public URL / VPS needed)
AIFOS_TELEGRAM_MODE=webhook

# LLM providers
GEMINI_API_KEY=
AIFOS_GEMINI_MODEL=gemini-2.5-flash
AIFOS_OPENAI_API_KEY=
AIFOS_OPENAI_MODEL=gpt-4o-mini
AIFOS_ANTHROPIC_API_KEY=
AIFOS_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local fallback mode
AIFOS_ALLOW_MOCK_LLM=true

# Background task dispatch: "background" (zero-infra) or "arq" (Redis-backed durable queue)
AIFOS_TASK_BACKEND=background
AIFOS_REDIS_URL=redis://localhost:6379/0

# Admin UI auth. Leave AIFOS_ADMIN_PASSWORD blank to restrict /admin to localhost only.
AIFOS_ADMIN_USERNAME=admin
AIFOS_ADMIN_PASSWORD=

# Structured JSON logs (recommended in production)
AIFOS_JSON_LOGS=false

# Observability: expose Prometheus metrics at /metrics
AIFOS_METRICS_ENABLED=false
